// Product alias hosts, redirected to the product's page; see products.ts. Deploy:
// `npx wrangler deploy -c worker/wrangler.jsonc`. Porthmeus and Archetypon live at
// gildrb.com/porthmeus and gildrb.com/archetypon. eukhe.com and www.eukhe.com belong to the
// eukhe-site Worker (repo gildrb/eukhe-site); this one keeps eukhe.gildrb.com, which redirects there.
{
  "name": "gildrb-products",
  "main": "products.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "routes": [
    { "pattern": "archetypon.gildrb.com", "custom_domain": true },
    { "pattern": "porthmeus.com", "custom_domain": true },
    { "pattern": "www.porthmeus.com", "custom_domain": true },
    { "pattern": "poros.gildrb.com", "custom_domain": true },
    { "pattern": "porthmeus.gildrb.com", "custom_domain": true },
    { "pattern": "eukhe.gildrb.com", "custom_domain": true },
  ],
}
